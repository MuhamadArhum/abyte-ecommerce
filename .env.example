# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="mysql://abyte:abyte_password@localhost:3306/abyte_ecommerce"
MARIADB_ROOT_PASSWORD="change_me_root_password"
MARIADB_DATABASE="abyte_ecommerce"
MARIADB_USER="abyte"
MARIADB_PASSWORD="abyte_password"

# ── Backend (NestJS) ─────────────────────────────────────────────────────
PORT=3010
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN="http://localhost:5183"

# JWT — generate strong random secrets for production, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET="replace_with_a_long_random_secret_access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace_with_a_long_random_secret_refresh"
JWT_REFRESH_EXPIRES_IN="7d"

BCRYPT_SALT_ROUNDS=12

THROTTLE_TTL=60
THROTTLE_LIMIT=100
TRUST_PROXY=false

# ── Frontend (Next.js) ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3010/api/v1"
